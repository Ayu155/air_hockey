<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Web Game - Versus & CPU</title>
    <style>
        /* Gaya CSS untuk tampilan Animasi / Realistis */
        body {
            margin: 0;
            padding: 0;
            /* UBAH URL DI BAWAH UNTUK LATAR BELAKANG REALISTIS (Misal: 'background.jpg') */
            background: url('https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=1920&auto=format&fit=crop') center/cover no-repeat;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            backdrop-filter: blur(3px); /* Efek blur untuk menonjolkan game */
        }

        #game-container {
            position: relative;
        }

        canvas {
            background: rgba(10, 10, 20, 0.8);
            border-radius: 10px;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
            border: 2px solid #0ff;
        }

        #ui {
            text-align: center;
            margin-bottom: 15px;
            background: rgba(0, 0, 0, 0.6);
            padding: 10px 30px;
            border-radius: 10px;
            border: 1px solid #0ff;
        }

        h2, h3 { margin: 5px 0; font-weight: normal; }
        
        .controls button {
            background: transparent;
            color: #0ff;
            border: 1px solid #0ff;
            padding: 8px 15px;
            margin: 5px;
            cursor: pointer;
            border-radius: 5px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .controls button:hover {
            background: #0ff;
            color: #000;
        }

        .active-mode {
            background: #0ff !important;
            color: #000 !important;
        }
    </style>
</head>
<body>

    <div id="ui">
        <h2>Level: <span id="levelDisplay" style="color: #ff00ff; font-weight: bold;">1</span> | Waktu Tersisa: <span id="timeDisplay" style="color: #ff0;">60</span>s</h2>
        <h3>Player 1: <span id="score1">0</span> &nbsp;&nbsp;|&nbsp;&nbsp; Player 2 / CPU: <span id="score2">0</span></h3>
        <div class="controls">
            <button id="btnCPU" class="active-mode" onclick="setMode('cpu')">Mode Lawan Komputer</button>
            <button id="btnP2" onclick="setMode('p2')">Mode Main Berdua</button>
            <button onclick="startGame()">Mulai Ulang / Start</button>
        </div>
        <p style="font-size: 12px; color: #ccc;">Kontrol P1: <b>W / S</b> &nbsp;|&nbsp; Kontrol P2: <b>Panah Atas / Bawah</b></p>
    </div>

    <div id="game-container">
        <canvas id="gameCanvas" width="800" height="450"></canvas>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        // Sistem Suara (Sintesis Audio agar tidak perlu file mp3 eksternal)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            if (type === 'hit') {
                oscillator.type = 'square';
                oscillator.frequency.setValueAtTime(400, audioCtx.currentTime);
                oscillator.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.1);
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.1);
            } else if (type === 'score') {
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(600, audioCtx.currentTime);
                oscillator.frequency.linearRampToValueAtTime(800, audioCtx.currentTime + 0.2);
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.3);
            }
        }

        // Variabel Game
        let gameMode = 'cpu'; // 'cpu' atau 'p2'
        let isRunning = false;
        let animationId;
        
        // Timer dan Level
        let timeRemaining = 60;
        let level = 1;
        let timerInterval;
        let baseSpeed = 5;

        // Entitas
        const ball = { x: 400, y: 225, radius: 10, speedX: 5, speedY: 5, color: "#fff" };
        const paddle1 = { x: 20, y: 175, width: 10, height: 100, color: "#0ff", dy: 0, score: 0 };
        const paddle2 = { x: 770, y: 175, width: 10, height: 100, color: "#f0f", dy: 0, score: 0 };

        // Input Keyboard
        const keys = { w: false, s: false, ArrowUp: false, ArrowDown: false };

        window.addEventListener("keydown", (e) => {
            if (keys.hasOwnProperty(e.key)) keys[e.key] = true;
        });
        window.addEventListener("keyup", (e) => {
            if (keys.hasOwnProperty(e.key)) keys[e.key] = false;
        });

        // Kontrol UI
        function setMode(mode) {
            gameMode = mode;
            document.getElementById('btnCPU').classList.remove('active-mode');
            document.getElementById('btnP2').classList.remove('active-mode');
            if (mode === 'cpu') document.getElementById('btnCPU').classList.add('active-mode');
            else document.getElementById('btnP2').classList.add('active-mode');
            startGame();
        }

        function resetBall() {
            ball.x = canvas.width / 2;
            ball.y = canvas.height / 2;
            ball.speedX = (ball.speedX > 0 ? -baseSpeed : baseSpeed) * (level * 0.15 + 1); // Semakin cepat saat level naik
            ball.speedY = baseSpeed * (Math.random() > 0.5 ? 1 : -1);
        }

        function updateTimer() {
            if (!isRunning) return;
            timeRemaining--;
            document.getElementById("timeDisplay").innerText = timeRemaining;

            if (timeRemaining <= 0) {
                level++;
                timeRemaining = 60 + (level * 10); // Waktu bertambah tiap level
                baseSpeed += 1; // Bola makin cepat
                document.getElementById("levelDisplay").innerText = level;
                playSound('score');
            }
        }

        function startGame() {
            paddle1.score = 0;
            paddle2.score = 0;
            level = 1;
            baseSpeed = 5;
            timeRemaining = 60;
            
            document.getElementById("score1").innerText = 0;
            document.getElementById("score2").innerText = 0;
            document.getElementById("levelDisplay").innerText = level;
            document.getElementById("timeDisplay").innerText = timeRemaining;
            
            resetBall();
            
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(updateTimer, 1000);
            
            isRunning = true;
            if (!animationId) gameLoop();
        }

        // Logika Fisika dan Pergerakan
        function update() {
            // Gerak Paddle P1
            if (keys.w && paddle1.y > 0) paddle1.y -= 7;
            if (keys.s && paddle1.y < canvas.height - paddle1.height) paddle1.y += 7;

            // Gerak Paddle P2 / CPU
            if (gameMode === 'p2') {
                if (keys.ArrowUp && paddle2.y > 0) paddle2.y -= 7;
                if (keys.ArrowDown && paddle2.y < canvas.height - paddle2.height) paddle2.y += 7;
            } else {
                // Logika AI Komputer (Versi Realistis dengan sedikit delay/error rate)
                let targetY = ball.y - (paddle2.height / 2);
                let speedCPU = 4 + (level * 0.5); // AI makin pintar saat level naik
                if (paddle2.y < targetY - 10) paddle2.y += speedCPU;
                else if (paddle2.y > targetY + 10) paddle2.y -= speedCPU;
                
                // Batas dinding untuk CPU
                if(paddle2.y < 0) paddle2.y = 0;
                if(paddle2.y > canvas.height - paddle2.height) paddle2.y = canvas.height - paddle2.height;
            }

            // Gerak Bola
            ball.x += ball.speedX;
            ball.y += ball.speedY;

            // Pantulan Atas Bawah
            if (ball.y + ball.radius > canvas.height || ball.y - ball.radius < 0) {
                ball.speedY *= -1;
            }

            // Deteksi Tabrakan dengan Paddle
            let hitPaddle1 = (ball.x - ball.radius < paddle1.x + paddle1.width && ball.y > paddle1.y && ball.y < paddle1.y + paddle1.height);
            let hitPaddle2 = (ball.x + ball.radius > paddle2.x && ball.y > paddle2.y && ball.y < paddle2.y + paddle2.height);

            if (hitPaddle1) {
                ball.speedX = Math.abs(ball.speedX); // Paksa ke kanan
                playSound('hit');
            } else if (hitPaddle2) {
                ball.speedX = -Math.abs(ball.speedX); // Paksa ke kiri
                playSound('hit');
            }

            // Skor
            if (ball.x < 0) {
                paddle2.score++;
                document.getElementById("score2").innerText = paddle2.score;
                playSound('score');
                resetBall();
            } else if (ball.x > canvas.width) {
                paddle1.score++;
                document.getElementById("score1").innerText = paddle1.score;
                playSound('score');
                resetBall();
            }
        }

        // Menggambar Frame
        function draw() {
            // Bersihkan Canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Garis Tengah (Gaya Animasi Neon)
            ctx.strokeStyle = "rgba(255, 255, 255, 0.2)";
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.setLineDash([10, 15]);
            ctx.moveTo(canvas.width / 2, 0);
            ctx.lineTo(canvas.width / 2, canvas.height);
            ctx.stroke();
            ctx.setLineDash([]); // Reset dash

            // Menggambar Paddle
            ctx.shadowBlur = 15;
            ctx.shadowColor = paddle1.color;
            ctx.fillStyle = paddle1.color;
            ctx.fillRect(paddle1.x, paddle1.y, paddle1.width, paddle1.height);

            ctx.shadowColor = paddle2.color;
            ctx.fillStyle = paddle2.color;
            ctx.fillRect(paddle2.x, paddle2.y, paddle2.width, paddle2.height);

            // Menggambar Bola
            ctx.shadowColor = ball.color;
            ctx.fillStyle = ball.color;
            ctx.beginPath();
            ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0; // Reset shadow untuk peforma
        }

        // Loop Game Utama
        function gameLoop() {
            if (isRunning) {
                update();
                draw();
            }
            animationId = requestAnimationFrame(gameLoop);
        }
    </script>
</body>
</html>
